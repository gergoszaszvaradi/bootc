#!/usr/bin/env bash

if pkill -x -u "$(id -u)" 'swaybg|swayidle'; then
    sleep 0.2
fi

mkdir -p ~/.local/share/backgrounds
cp -f $(ls -d /usr/share/backgrounds/fall/* | shuf -n1) ~/.local/share/backgrounds/current

swaybg --mode fill --image ~/.local/share/backgrounds/current &
swayidle -w timeout 300 "swaylock -f" timeout 600 'systemctl suspend' before-sleep "swaylock -f"
